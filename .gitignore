# Headless secrets + generated policy — NEVER commit.
# Matched by pattern, not by name: this file used to list `config/autopilot.env`, and
# renaming the project walked the real secrets straight past the rule and into a commit.
config/*.env
!config/*.env.example
config/headless-settings.json

node_modules/

# Built control panel (contract §5) — regenerated by `npm run panel`.
dashboard/panel-dist/

# TypeScript incremental build cache — regenerated by every build, not source.
*.tsbuildinfo

# Raw agent stdout captures. The panel's Console view reads the file on disk live; the actual
# audit trail (what happened, when, with what result) lives in status.json/events.jsonl, so
# this is pure process-output churn with no history value — one dirty file per rerun forever.
**/panel-run*.log

# Scan telemetry the server only ever appends to, never reads back (last-scan.json is the one
# it restores from on boot to avoid a scan storm after restart — that one stays tracked).
queue-runs/scans.jsonl

# jira.mjs's raw-fetch error diagnostics print credential fingerprints (token length + tail,
# account email) to debug a failed fetch — useful on a terminal, never safe to commit.
tickets/*/.raw-*.err
tickets/*/raw-*.err

# The PR inbox is a rebuildable cache of open-PR metadata, refreshed every few minutes.
pr-inbox/

# A minted browser session: holds a live JWT and the encrypted auth cookie. Never commit it.
# `scripts/session.mjs --verify` reports whether it is still valid; re-mint rather than share.
.session/
