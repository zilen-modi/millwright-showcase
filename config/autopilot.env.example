# Autopilot headless credentials. Copy to autopilot/config/autopilot.env and fill in.
# NEVER commit the real file (it is gitignored).
JIRA_BASE_URL=https://acme.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=            # Atlassian API token: https://id.atlassian.com/manage-profile/security/api-tokens
NPM_TOKEN=                 # GitHub PAT with read:packages, for private @acme-it-erp/* packages (npm.pkg.github.com)

# Browser / E2E testing against the local stack (scripts/session.mjs, scripts/e2e.mjs).
# Use a DEDICATED TEST ACCOUNT. Never a personal login - runs drive real flows against a real
# backend, and anything they do is done as this user.
E2E_USERNAME=
E2E_PASSWORD=
# Optional. Defaults shown; override only if your stack differs.
# E2E_APP_BASE=http://localhost:3000
# E2E_API_BASE=http://localhost:4000
# Must match the frontend's NEXT_PUBLIC_TOKEN_SECRET, or the cookie will not decrypt.
# Leave unset to use the app's own fallback ('fallback-secret-key'), which is what a local
# stack started without the variable is running on.
# E2E_TOKEN_SECRET=
